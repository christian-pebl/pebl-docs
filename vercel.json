{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "docusaurus-2",
  "redirects": [
    {
      "source": "/docs/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/camera-configuration",
      "destination": "/mooring-guide/camera-configuration",
      "permanent": true
    },
    {
      "source": "/frame-configurations",
      "destination": "/mooring-guide/frame-configurations",
      "permanent": true
    },
    {
      "source": "/frame-configurations/:path*",
      "destination": "/mooring-guide/frame-configurations/:path*",
      "permanent": true
    },
    {
      "source": "/moorings",
      "destination": "/mooring-guide/frame-configurations/",
      "permanent": true
    },
    {
      "source": "/moorings/",
      "destination": "/mooring-guide/frame-configurations/",
      "permanent": true
    },
    {
      "source": "/moorings/:path*",
      "destination": "/mooring-guide/frame-configurations/:path*",
      "permanent": true
    }
  ]
}
