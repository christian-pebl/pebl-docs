{
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "framework": "docusaurus-2",
  "redirects": [
    {
      "source": "/docs/:path*",
      "destination": "/:path*",
      "permanent": true
    },
    {
      "source": "/moorings",
      "destination": "/frame-configurations/",
      "permanent": true
    },
    {
      "source": "/moorings/",
      "destination": "/frame-configurations/",
      "permanent": true
    },
    {
      "source": "/moorings/:path*",
      "destination": "/frame-configurations/:path*",
      "permanent": true
    }
  ]
}
